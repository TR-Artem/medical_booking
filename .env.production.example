# Production / demo-стенд. Скопировать в .env.production и заполнить.
# Настоящий .env.production в git не попадает (см. .gitignore).

# Django
SECRET_KEY=change_me_to_a_long_random_string_at_least_50_chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Для HTTPS на VPS: домен без схемы и доверенные origin со схемой.
# ALLOWED_HOSTS=clinic.example.ru
CSRF_TRUSTED_ORIGINS=

# Database (имена совпадают с сервисом db в docker-compose.prod.yml)
DB_NAME=medical_db
DB_USER=medical_user
DB_PASSWORD=change_me_db_password
DB_HOST=db
DB_PORT=5432

# Email (SMTP). Для демо можно оставить пустым: письма не отправятся, ошибки не будет
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=МедЦентр <noreply@medcenter.ru>

# Redis (для Celery)
REDIS_URL=redis://redis:6379/0

# Site
SITE_URL=http://localhost

# HTTPS (включать после настройки сертификата)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
