# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=medical_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Email (Mailpit в docker compose: http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=МедЦентр <noreply@medcenter.ru>

# Redis (Celery и кэш)
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# Site
SITE_URL=http://localhost:8080
APP_VERSION=0.4.0
